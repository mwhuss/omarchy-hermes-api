#!/usr/bin/bash
# Toggle (or open/close) the Omarchy Hermes API flyout via Quickshell IPC.
# Usage: hermes-toggle [toggle|open|close|toggleAppWindow]   (default: toggle)
set -euo pipefail

IPC_TARGET="com.mwhuss.omarchy-hermes-api"
SHELL_PROJECT="${OMARCHY_SHELL_PROJECT:-/usr/share/omarchy/shell}"

verb="${1:-toggle}"
case "$verb" in
  toggle|open|close|toggleAppWindow) ;;
  *) echo "usage: hermes-toggle [toggle|open|close|toggleAppWindow]" >&2; exit 1 ;;
esac

QUICKSHELL_BIN="/usr/bin/quickshell"
if [ ! -x "$QUICKSHELL_BIN" ]; then
  QUICKSHELL_BIN="$(command -v quickshell 2>/dev/null || true)"
fi

if [ -z "$QUICKSHELL_BIN" ] || [ ! -x "$QUICKSHELL_BIN" ]; then
  echo "hermes-toggle: 'quickshell' binary not found at /usr/bin/quickshell or on PATH" >&2
  exit 1
fi

"$QUICKSHELL_BIN" -p "$SHELL_PROJECT" ipc call "$IPC_TARGET" "$verb"
